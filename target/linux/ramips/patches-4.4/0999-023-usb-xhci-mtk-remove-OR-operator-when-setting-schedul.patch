From 11a2f63421cd8515aa187e896d0ad3fbe83e4b6a Mon Sep 17 00:00:00 2001
From: HiGarfield <HiGarfield@126.com>
Date: Sat, 31 Oct 2026 23:49:16 +0800
Subject: [PATCH] usb: xhci-mtk: remove OR operator when setting schedule
 parameters

Write complete scheduling values instead of ORing them with previous contents. This prevents stale bits from surviving endpoint reconfiguration; the other bits in these dwords are reserved.

Based on the upstream patch titled 'usb: xhci-mtk: remove or operator for setting schedule parameters'.
---
 drivers/usb/host/xhci-mtk-sch.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/usb/host/xhci-mtk-sch.c b/drivers/usb/host/xhci-mtk-sch.c
index bd21b66d..257ab117 100644
--- a/drivers/usb/host/xhci-mtk-sch.c
+++ b/drivers/usb/host/xhci-mtk-sch.c
@@ -379,9 +379,9 @@ int xhci_mtk_add_ep_quirk(struct usb_hcd *hcd, struct usb_device *udev,
 	list_add_tail(&sch_ep->endpoint, &sch_bw->bw_ep_list);
 	sch_ep->ep = ep;
 
-	ep_ctx->reserved[0] |= cpu_to_le32(EP_BPKTS(sch_ep->pkts)
+	ep_ctx->reserved[0] = cpu_to_le32(EP_BPKTS(sch_ep->pkts)
 		| EP_BCSCOUNT(sch_ep->cs_count) | EP_BBM(sch_ep->burst_mode));
-	ep_ctx->reserved[1] |= cpu_to_le32(EP_BOFFSET(sch_ep->offset)
+	ep_ctx->reserved[1] = cpu_to_le32(EP_BOFFSET(sch_ep->offset)
 		| EP_BREPEAT(sch_ep->repeat));
 
 	xhci_dbg(xhci, " PKTS:%x, CSCOUNT:%x, BM:%x, OFFSET:%x, REPEAT:%x\n",
-- 
2.43.0

