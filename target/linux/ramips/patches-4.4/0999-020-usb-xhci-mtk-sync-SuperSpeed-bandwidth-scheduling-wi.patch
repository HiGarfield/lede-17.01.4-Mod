From 4611f4def4cecba2d1b4cd8805dae3d9fbf45a65 Mon Sep 17 00:00:00 2001
From: HiGarfield <HiGarfield@126.com>
Date: Mon, 26 Oct 2026 23:50:32 +0800
Subject: [PATCH] usb: xhci-mtk: sync SuperSpeed bandwidth scheduling with
 upstream

The same hub with the same disk and the same thumb drive is stable on a
PC running Ubuntu 26.04 and on Windows, and it fails on MT7621 with
COMP_TX_ERR on the SuperSpeed bulk IN endpoint.  The PC host does not
run this driver at all, and need_bw_sch() makes this scheduler the one
piece of code here that runs exactly when a USB hub is attached: a
directly attached disk has only bulk endpoints, which are skipped,
while a SuperSpeed hub adds a periodic status-change endpoint that the
scheduler does program.  That is the difference the field data points
at.

The SuperSpeed branch of setup_sch_info() still uses the values from
the original 2015 implementation and is missing what upstream changed
afterwards:

  - burst_mode stayed 0.  Upstream sets it to 1 for SuperSpeed, which
    is what EP_BBM in the endpoint context tells the host controller
    about spreading a burst over the budgeted microframes.
  - esit_pkts was always (mult+1)*(max_burst+1).  Upstream derives it
    from the endpoint's max_esit_payload and only falls back to
    mult/burst when the descriptor reports 0, which is what a hub
    status endpoint typically does - so its packets per interval were
    computed from the wrong quantity.
  - esit was only clamped to XHCI_MTK_MAX_ESIT inside check_sch_bw(),
    after setup_sch_info() had already used the unclamped value;
    upstream clamps it up front.
  - an isochronous endpoint with esit == 1 fell through to the
    round-up branch and could end up with pkts == 0.
  - EP_BPKTS only had 6 bits while the field is 7.
  - the scheduling fields were OR-ed into ep_ctx->reserved[], which
    keeps whatever was there before; upstream assigns them.

Backport those together with CTX_TO_MAX_ESIT_PAYLOAD_HI from upstream
xhci-mtk-sch.c / xhci-mtk.h (the SuperSpeed parts of commit 95b516c186
"usb: xhci-mtk: improve bandwidth scheduling" and its follow-ups).
HighSpeed, FullSpeed and LowSpeed scheduling is unchanged.
---
 drivers/usb/host/xhci-mtk-sch.c | 28 +++++++++++++++++++++++-----
 drivers/usb/host/xhci.h         |  1 +
 2 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/drivers/usb/host/xhci-mtk-sch.c b/drivers/usb/host/xhci-mtk-sch.c
index f121f515..d6f6f33c 100644
--- a/drivers/usb/host/xhci-mtk-sch.c
+++ b/drivers/usb/host/xhci-mtk-sch.c
@@ -29,7 +29,7 @@
 #define FS_PAYLOAD_MAX 188
 
 /* mtk scheduler bitmasks */
-#define EP_BPKTS(p)	((p) & 0x3f)
+#define EP_BPKTS(p)	((p) & 0x7f)
 #define EP_BCSCOUNT(p)	(((p) & 0x7) << 8)
 #define EP_BBM(p)	((p) << 11)
 #define EP_BOFFSET(p)	((p) & 0x3fff)
@@ -82,14 +82,21 @@ static void setup_sch_info(struct usb_device *udev,
 	u32 max_burst;
 	u32 mult;
 	u32 esit_pkts;
+	u32 max_esit_payload;
 
 	ep_type = CTX_TO_EP_TYPE(le32_to_cpu(ep_ctx->ep_info2));
 	ep_interval = CTX_TO_EP_INTERVAL(le32_to_cpu(ep_ctx->ep_info));
 	max_packet_size = MAX_PACKET_DECODED(le32_to_cpu(ep_ctx->ep_info2));
 	max_burst = CTX_TO_MAX_BURST(le32_to_cpu(ep_ctx->ep_info2));
 	mult = CTX_TO_EP_MULT(le32_to_cpu(ep_ctx->ep_info));
+	max_esit_payload =
+		(CTX_TO_MAX_ESIT_PAYLOAD_HI(
+			le32_to_cpu(ep_ctx->ep_info)) << 16) |
+		 CTX_TO_MAX_ESIT_PAYLOAD(le32_to_cpu(ep_ctx->tx_info));
 
 	sch_ep->esit = 1 << ep_interval;
+	if (sch_ep->esit > XHCI_MTK_MAX_ESIT)
+		sch_ep->esit = XHCI_MTK_MAX_ESIT;
 	sch_ep->offset = 0;
 	sch_ep->burst_mode = 0;
 
@@ -114,7 +121,16 @@ static void setup_sch_info(struct usb_device *udev,
 	} else if (udev->speed == USB_SPEED_SUPER) {
 		/* usb3_r1 spec section4.4.7 & 4.4.8 */
 		sch_ep->cs_count = 0;
-		esit_pkts = (mult + 1) * (max_burst + 1);
+		sch_ep->burst_mode = 1;
+		/*
+		 * some device's (d)wBytesPerInterval is set as 0,
+		 * then max_esit_payload is 0, so evaluate esit_pkts from
+		 * mult and burst
+		 */
+		esit_pkts = DIV_ROUND_UP(max_esit_payload, max_packet_size);
+		if (esit_pkts == 0)
+			esit_pkts = (mult + 1) * (max_burst + 1);
+
 		if (ep_type == INT_IN_EP || ep_type == INT_OUT_EP) {
 			sch_ep->pkts = esit_pkts;
 			sch_ep->num_budget_microframes = 1;
@@ -122,7 +138,9 @@ static void setup_sch_info(struct usb_device *udev,
 		}
 
 		if (ep_type == ISOC_IN_EP || ep_type == ISOC_OUT_EP) {
-			if (esit_pkts <= sch_ep->esit)
+			if (sch_ep->esit == 1)
+				sch_ep->pkts = esit_pkts;
+			else if (esit_pkts <= sch_ep->esit)
 				sch_ep->pkts = 1;
 			else
 				sch_ep->pkts = roundup_pow_of_two(esit_pkts)
@@ -365,9 +383,9 @@ int xhci_mtk_add_ep_quirk(struct usb_hcd *hcd, struct usb_device *udev,
 	list_add_tail(&sch_ep->endpoint, &sch_bw->bw_ep_list);
 	sch_ep->ep = ep;
 
-	ep_ctx->reserved[0] |= cpu_to_le32(EP_BPKTS(sch_ep->pkts)
+	ep_ctx->reserved[0] = cpu_to_le32(EP_BPKTS(sch_ep->pkts)
 		| EP_BCSCOUNT(sch_ep->cs_count) | EP_BBM(sch_ep->burst_mode));
-	ep_ctx->reserved[1] |= cpu_to_le32(EP_BOFFSET(sch_ep->offset)
+	ep_ctx->reserved[1] = cpu_to_le32(EP_BOFFSET(sch_ep->offset)
 		| EP_BREPEAT(sch_ep->repeat));
 
 	xhci_dbg(xhci, " PKTS:%x, CSCOUNT:%x, BM:%x, OFFSET:%x, REPEAT:%x\n",
diff --git a/drivers/usb/host/xhci.h b/drivers/usb/host/xhci.h
index cc853077..8660b882 100644
--- a/drivers/usb/host/xhci.h
+++ b/drivers/usb/host/xhci.h
@@ -758,6 +758,7 @@ struct xhci_ep_ctx {
 #define AVG_TRB_LENGTH_FOR_EP(p)	((p) & 0xffff)
 #define MAX_ESIT_PAYLOAD_FOR_EP(p)	(((p) & 0xffff) << 16)
 #define CTX_TO_MAX_ESIT_PAYLOAD(p)	(((p) >> 16) & 0xffff)
+#define CTX_TO_MAX_ESIT_PAYLOAD_HI(p)	(((p) >> 24) & 0xff)
 
 /* deq bitmasks */
 #define EP_CTX_CYCLE_MASK		(1 << 0)
-- 
2.43.0

