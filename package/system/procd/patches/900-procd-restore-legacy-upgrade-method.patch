+	} else if (in->restart || in->respawn) {
+		/*
+		 * Not present in procd 9a4036fb; added deliberately.
+		 *
+		 * That version returns from instance_exit() *before*
+		 * uloop_timeout_cancel(), so when /sbin/sysupgrade kills a
+		 * service whose respawn timer is already armed, the timer
+		 * still fires and restarts the very daemon that was just
+		 * killed - which is exactly the failure this flag exists
+		 * to prevent.  Re-check it here.
