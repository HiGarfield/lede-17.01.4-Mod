+/*
+ * Taken over from procd 9a4036fb (upgraded/upgraded.c:39-55), where it
+ * was called sysupgarde() - misspelling included.
+ *
+ * procd exec'ed us through the "nandupgrade" ubus method, without any
+ * chroot, and expects us to re-enter /sbin/sysupgrade with the "nand"
+ * subcommand, which then drives /lib/upgrade/nand.sh to the end.
+ *
+ * Deviation, marked below: 9a4036fb never registered the child with
+ * uloop, so its uloop_run() returned immediately and the box rebooted
+ * while /sbin/sysupgrade nand was still running.  Upstream fixed this in
+ * commit d749b2a3 ("upgraded: register stage2 process in uloop as
+ * intended", 2017-07-12), which was never merged into the LEDE 17.01
+ * branch - that is why procd 9a4036fb still lacks it.
+ */
+static void sysupgrade_nand(char *folder)
+{
+	char *args[] = { "/sbin/sysupgrade", "nand", NULL, NULL };
+
+	args[2] = folder;
+	upgrade_proc.cb = upgrade_proc_cb;
+	upgrade_proc.pid = fork();
+	if (upgrade_proc.pid < 0) {
+		fprintf(stderr, "Failed to fork sysupgrade\n");
+		return;
+	}
+
+	if (!upgrade_proc.pid) {
+		execvp(args[0], args);
+		fprintf(stderr, "Failed to exec sysupgrade\n");
+		_exit(EXIT_FAILURE);
+	}
+
+	/*
+	 * Deviation from 9a4036fb: uloop_process_add(), so that
+	 * upgrade_proc_cb actually fires and uloop_run() below waits for
+	 * the child instead of returning at once.
+	 */
+	uloop_process_add(&upgrade_proc);
+}
