+/*
+ * Legacy "nandupgrade" ubus method.
+ *
+ * This is what /lib/upgrade/nand.sh of LEDE 17.01 calls from
+ * nand_upgrade_stage1(), after having copied /sbin/upgraded to /tmp:
+ *
+ *	ubus call system nandupgrade '{"path": "/tmp/sysupgrade.img"}'
+ *
+ * procd execs /tmp/upgraded, so this process becomes PID 1 from here on.
+ *
+ * Beware: nand_upgrade_stage1() exits unconditionally right after this
+ * ubus call, so if the method is missing the upgrade silently does
+ * nothing at all and the box just reboots into the old firmware.
+ */
+enum {
+	NAND_PATH,
+	__NAND_MAX
+};
+
+static const struct blobmsg_policy nand_policy[__NAND_MAX] = {
+	[NAND_PATH] = { .name = "path", .type = BLOBMSG_TYPE_STRING },
+};
+
+static void
+procd_spawn_upgraded(char *path)
+{
+	char *wdt_fd = watchdog_fd();
+	char *argv[] = { "/tmp/upgraded", NULL, NULL};
+
+	argv[1] = path;
+
+	DEBUG(2, "Exec to upgraded now\n");
+	if (wdt_fd) {
+		watchdog_set_cloexec(false);
+		setenv("WDTFD", wdt_fd, 1);
+	}
+	execvp(argv[0], argv);
+}
+
+static int nand_set(struct ubus_context *ctx, struct ubus_object *obj,
+		    struct ubus_request_data *req, const char *method,
+		    struct blob_attr *msg)
+{
+	struct blob_attr *tb[__NAND_MAX];
+
+	if (!msg)
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	blobmsg_parse(nand_policy, __NAND_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[NAND_PATH])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	procd_spawn_upgraded(blobmsg_get_string(tb[NAND_PATH]));
+	fprintf(stderr, "Yikees, something went wrong. no /sbin/upgraded ?\n");
+
+	return 0;
+}
+
