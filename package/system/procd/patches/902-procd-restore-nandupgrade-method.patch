+/*
+ * Legacy NAND upgrade (LEDE 17.01 and older).
+ *
+ * procd exec'ed us via the "nandupgrade" ubus method, without preparing
+ * any chroot, and expects us to re-enter /sbin/sysupgrade with the "nand"
+ * subcommand, which then drives /lib/upgrade/nand.sh to the end.
+ */
+static void sysupgrade_nand(char *path)
+{
+	char *args[] = { "/sbin/sysupgrade", "nand", NULL, NULL };
+
+	args[2] = path;
+
+	upgrade_proc.cb = upgrade_proc_cb;
+	upgrade_proc.pid = fork();
+	if (upgrade_proc.pid < 0) {
+		fprintf(stderr, "Failed to fork sysupgrade\n");
+		return;
+	}
+
+	if (!upgrade_proc.pid) {
+		/* Child */
+		execvp(args[0], args);
+		fprintf(stderr, "Failed to exec sysupgrade\n");
+		_exit(EXIT_FAILURE);
+	}
+
+	uloop_process_add(&upgrade_proc);
+	uloop_run();
+}
