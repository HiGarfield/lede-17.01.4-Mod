+# Build upgraded statically.
+#
+# /lib/upgrade/nand.sh of LEDE 17.01 does a plain
+#
+#	cp /sbin/upgraded /tmp/
+#
+# and lets procd exec /tmp/upgraded from inside the ramfs, where no shared
+# libraries are available at all.  A dynamically linked binary would simply
+# fail to start there ("not found" from the loader), so restore the static
+# link used by the procd of that era.
+set(CMAKE_EXE_LINKER_FLAGS "-static -fPIC")
+set(CMAKE_FIND_LIBRARY_SUFFIXES .a)
+set(CMAKE_EXE_LINK_DYNAMIC_C_FLAGS)
+set(CMAKE_EXE_LINK_DYNAMIC_CXX_FLAGS)
+set(CMAKE_SHARED_LIBRARY_C_FLAGS)
+set(CMAKE_SHARED_LIBRARY_CXX_FLAGS)
+set(CMAKE_SHARED_LIBRARY_LINK_C_FLAGS)
+set(CMAKE_SHARED_LIBRARY_LINK_CXX_FLAGS)
+
 ADD_EXECUTABLE(upgraded upgraded.c ../watchdog.c)
-TARGET_LINK_LIBRARIES(upgraded ${ubox})
+TARGET_LINK_LIBRARIES(upgraded ubox rt -lc -lgcc_pic)
 INSTALL(TARGETS upgraded
