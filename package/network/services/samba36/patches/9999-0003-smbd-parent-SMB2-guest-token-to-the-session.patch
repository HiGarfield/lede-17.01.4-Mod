From a943b5f334c4cce55f3edd9932088990b761a81b Mon Sep 17 00:00:00 2001
From: HiGarfield <HiGarfield@126.com>
Date: Mon, 23 Nov 2026 23:36:30 +0800
Subject: [PATCH] smbd: parent SMB2 guest token to the session

do_map_to_guest() builds the token with make_server_info_guest(),
which allocates on the NULL talloc context. The token therefore
lives outside the session tree while compat_vuser references it.

Steal it onto the session so it is released exactly once when the
session goes away.
---
 source3/smbd/smb2_sesssetup.c | 9 +++++++++
 1 file changed, 9 insertions(+)

--- a/source3/smbd/smb2_sesssetup.c
+++ b/source3/smbd/smb2_sesssetup.c
@@ -233,6 +233,15 @@ static NTSTATUS setup_ntlmssp_session_in
 			&session->session_info,
 			auth_ntlmssp_get_username(session->auth_ntlmssp_state),
 			auth_ntlmssp_get_domain(session->auth_ntlmssp_state));
+		if (NT_STATUS_IS_OK(status) && (session->session_info != NULL)) {
+			/*
+			 * make_server_info_guest() allocates on the NULL
+			 * context.  Keep the token on the session tree so
+			 * that it cannot outlive the session (or be freed
+			 * while compat_vuser still references it).
+			 */
+			talloc_steal(session, session->session_info);
+		}
 	}
 	return status;
 }
