From 76f72ab372fab3ca2288a9f7962d64aa7375f07e Mon Sep 17 00:00:00 2001
From: HiGarfield <HiGarfield@126.com>
Date: Tue, 11 Nov 2025 01:22:35 +0800
Subject: [PATCH] improve tcpsocket

---
 src/network/tcpsocket.c | 24 ++++++++++++++++++++----
 1 file changed, 20 insertions(+), 4 deletions(-)

--- a/src/network/tcpsocket.c
+++ b/src/network/tcpsocket.c
@@ -225,6 +225,9 @@ static void client_read_cb(struct ustrea
                     dawnlog_error("not enough memory (" STR_QUOTE(__LINE__) ")\n");
                     dawn_free(cl->str);
                     cl->str = NULL;
+                    cl->state = READ_STATUS_READY;
+                    cl->curr_len = 0;
+                    cl->final_len = 0;
                     break;
                 }
                 handle_network_msg(dec);
@@ -320,6 +323,8 @@ static void server_cb(struct uloop_fd *f
     sfd = accept(server.fd, (struct sockaddr *) &cl->sin, &sl);
     if (sfd < 0) {
         dawnlog_error("Accept failed\n");
+        dawn_free(next_client);
+        next_client = NULL;
         return;
     }
 
@@ -332,11 +337,19 @@ static void server_cb(struct uloop_fd *f
         return;
     }
 
+    memset(&cl->s, 0, sizeof(cl->s));
     cl->s.stream.string_data = 1;
     cl->s.stream.notify_read = client_read_cb;
     cl->s.stream.notify_state = client_notify_state;
     cl->s.stream.notify_write = client_notify_write;
+    cl->ctr = 0;
+    cl->counter = 0;
+    cl->str = NULL;
+    cl->state = READ_STATUS_READY;
+    cl->final_len = 0;
+    cl->curr_len = 0;
     cl->time_alive = time(0);
+
     list_add(&cl->list, &cli_list);
     ustream_fd_init(&cl->s, sfd);
     dawn_regmem(&cl->s);
@@ -347,7 +360,7 @@ static void server_cb(struct uloop_fd *f
 int run_server(char *ipv4, int port) {
     dawnlog_debug("Adding socket!\n");
     char port_str[12];
-    sprintf(port_str, "%d", port); // TODO: Manage buffer length
+    snprintf(port_str, sizeof(port_str), "%d", port);
 
     /* To accept IPv6 peers, listen on the v6 wildcard (dual-stack)
      * instead of the Legacy IP default, unless the user configured
@@ -463,7 +476,7 @@ static int con_dial(struct network_con_s
     char *addr = con->addrs[con->cur_addr];
     char port_str[12];
 
-    sprintf(port_str, "%d", con->port); // TODO: Manage buffer length
+    snprintf(port_str, sizeof(port_str), "%d", con->port);
 
     if (getaddrinfo(addr, port_str, &hints, &res) || !res) {
         dawnlog_error("Failed to parse peer address %s\n", addr);
@@ -703,11 +716,14 @@ static int sockaddr_equal(const struct s
         const struct sockaddr_in6 *b6 = (const struct sockaddr_in6 *)b;
 
         return !memcmp(&a6->sin6_addr, &b6->sin6_addr, sizeof(a6->sin6_addr)) &&
-               a6->sin6_scope_id == b6->sin6_scope_id;
+               a6->sin6_scope_id == b6->sin6_scope_id &&
+               a6->sin6_port == b6->sin6_port;
     }
 
     return ((const struct sockaddr_in *)a)->sin_addr.s_addr ==
-           ((const struct sockaddr_in *)b)->sin_addr.s_addr;
+           ((const struct sockaddr_in *)b)->sin_addr.s_addr &&
+           ((const struct sockaddr_in *)a)->sin_port ==
+           ((const struct sockaddr_in *)b)->sin_port;
 }
 
 struct network_con_s* tcp_list_contains_address(const struct sockaddr_storage *entry) {
