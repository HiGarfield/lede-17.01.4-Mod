#!/bin/sh

# The wizard keeps no settings of its own anymore, it reads and writes
# the network and wireless configuration directly.  Remove the config
# file and the service left behind by previous versions so that those
# stored values cannot shadow the live configuration again.

rm -f /etc/config/wizard
rm -f /etc/init.d/wizard

uci -q batch <<-EOF >/dev/null
	delete ucitrack.@wizard[-1]
	commit ucitrack
EOF

rm -f /tmp/luci-indexcache
exit 0
