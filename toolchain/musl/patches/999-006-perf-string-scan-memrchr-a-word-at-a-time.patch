From da6c873f56c978d0acb2eefdecb03b5e5c2268b9 Mon Sep 17 00:00:00 2001
From: HiGarfield <HiGarfield@126.com>
Date: Thu, 19 Nov 2026 10:50:13 +0800
Subject: [PATCH] perf(string): scan memrchr a word at a time

memrchr walks backwards one byte at a time, which is slow for long
ranges with no match. Scan aligned words from the end, using the same
broadcast-byte trick as memchr, and fall back to bytes for the tail.

Scope:
- src/string/memrchr.c only; no header or build changes.
- End alignment is handled bytewise; matched words are confirmed
  bytewise from the end so the last occurrence is returned.
- The byte loop remains for ranges shorter than one word.

Risk:
- HASZERO can flag bytes above a real match because subtraction
  borrows through a following byte value of one. The confirmation
  loop avoids returning those false positions; a first version
  without it failed 729/200k randomized checks and was rejected.
- Word loads stay inside [s, s+n), so guard pages are safe.
- Pointer casts go through uintptr_t to keep -Wcast-qual clean.

Performance (x86_64, gcc 16, -Os, median of 9 runs):
- 128-byte miss: 70.1 -> 15.8 ns/call (4.4x)
- 16-byte miss: 9.5 -> 6.0 ns/call (1.6x)

Correctness:
- Independent reference comparison, 200k random cases plus edges.
- Guard-page test for all offsets and lengths up to 64 bytes.
- 32-bit i386 static build, valgrind clean, gcc/clang -Wall -Wextra
  -Werror -Wcast-qual -Wshadow clean.
---
 src/string/memrchr.c | 34 +++++++++++++++++++++++++++++++++-
 1 file changed, 33 insertions(+), 1 deletion(-)

diff --git a/src/string/memrchr.c b/src/string/memrchr.c
index e51748b..e9fab42 100644
--- a/src/string/memrchr.c
+++ b/src/string/memrchr.c
@@ -1,10 +1,42 @@
 #include <string.h>
+#include <stdint.h>
+#include <limits.h>
+
+#define ALIGN (sizeof(size_t))
+#define ONES ((size_t)-1/UCHAR_MAX)
+#define HIGHS (ONES * (UCHAR_MAX/2+1))
+#define HASZERO(x) (((x)-ONES) & ~(x) & HIGHS)
 
 void *__memrchr(const void *m, int c, size_t n)
 {
 	const unsigned char *s = m;
 	c = (unsigned char)c;
-	while (n--) if (s[n]==c) return (void *)(s+n);
+#ifdef __GNUC__
+	typedef size_t __attribute__((__may_alias__)) word;
+	if (n >= ALIGN) {
+		const unsigned char *p = s + n;
+		/* Align the end of the range down to a word boundary. */
+		while (n >= ALIGN && ((uintptr_t)p & (ALIGN-1))) {
+			if (*--p == c) return (void *)(uintptr_t)p;
+			n--;
+		}
+		word k = ONES * (word)c;
+		for (; n >= ALIGN; n -= ALIGN) {
+			const word *w = (const void *)(p - ALIGN);
+			word z = *w ^ k;
+			if (HASZERO(z)) {
+				/* HASZERO may also flag bytes above a match due
+				 * to borrow, so confirm from the end of the word. */
+				const unsigned char *b = (const void *)w;
+				size_t i = ALIGN;
+				while (i--) if (b[i] == c)
+					return (void *)(uintptr_t)(p - ALIGN + i);
+			}
+			p -= ALIGN;
+		}
+	}
+#endif
+	while (n--) if (s[n]==c) return (void *)(uintptr_t)(s+n);
 	return 0;
 }
 
