From 43371dd84616df0785f10dbcd4cab5283d82228e Mon Sep 17 00:00:00 2001
From: HiGarfield <HiGarfield@126.com>
Date: Thu, 19 Nov 2026 10:46:11 +0800
Subject: [PATCH] perf(string): compare memcmp a word at a time

The 1.1.24 memcmp walks bytes one at a time, leaving most of the
memory bandwidth unused on equal or late-differing buffers. Compare
aligned words from the left operand and fixed-size copies from the
right, then locate the first differing byte with ctz/clz.

Scope:
- src/string/memcmp.c only; no header or build changes.
- Keep the byte loop for short tails and an early-exit check for
  mismatches in the first byte.
- All GCC-compatible targets use the word path; unaligned reads are
  avoided by assembling the second word with a fixed-size copy.

Risk:
- The word path reads only bytes within n, so guard pages are safe.
- Big-endian uses clz with a width adjustment; reviewed but not
  executed (host is little-endian).

Performance (x86_64, gcc 16, -Os, median of 9 runs):
- 128-byte equal: 67.7 -> 15.3 ns/call (4.4x)
- 128-byte last-byte diff: 69.9 -> 14.2 ns/call (4.9x)
- 16-byte equal: 11.0 -> 5.0 ns/call (2.2x)
- first-byte diff: 2.3 -> 1.5 ns/call (faster)

Correctness:
- Independent reference comparison, 200k random cases plus edges.
- Guard-page test for all offsets and lengths up to 64 bytes.
- 32-bit i386 static build, valgrind clean, gcc/clang -Wall -Wextra
  -Werror -Wcast-qual -Wshadow clean.
---
 src/string/memcmp.c | 41 +++++++++++++++++++++++++++++++++++++++--
 1 file changed, 39 insertions(+), 2 deletions(-)

diff --git a/src/string/memcmp.c b/src/string/memcmp.c
index bdbce9f..52f8f35 100644
--- a/src/string/memcmp.c
+++ b/src/string/memcmp.c
@@ -1,8 +1,45 @@
 #include <string.h>
+#include <stdint.h>
+
+#define ALIGN (sizeof(size_t))
 
 int memcmp(const void *vl, const void *vr, size_t n)
 {
-	const unsigned char *l=vl, *r=vr;
+	const unsigned char *l = vl, *r = vr;
+#ifdef __GNUC__
+	typedef size_t __attribute__((__may_alias__)) word;
+	/* Fast path for an early mismatch, which is common in hash-table
+	 * lookups and avoids any setup cost for the word loop below. */
+	if (n && *l != *r) return (int)*l - (int)*r;
+	/* Compare whole machine words when enough bytes remain. The second
+	 * operand may be unaligned, so its word is assembled with a fixed-size
+	 * copy; this is portable to targets that fault on unaligned loads. */
+	if (n >= 2*ALIGN) {
+		while ((uintptr_t)l & (ALIGN-1)) {
+			if (*l != *r) return (int)*l - (int)*r;
+			l++; r++; n--;
+		}
+		const word *wl = (const void *)l;
+		for (; n >= ALIGN; n -= ALIGN, r += ALIGN) {
+			word x = *wl++;
+			word y;
+			__builtin_memcpy(&y, r, ALIGN);
+			word z = x ^ y;
+			if (z) {
+				size_t k;
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+				k = (size_t)__builtin_ctzll((uint64_t)z) / 8;
+#else
+				k = (size_t)(__builtin_clzll((uint64_t)z) - (64 - 8*ALIGN)) / 8;
+#endif
+				const unsigned char *xb = (const void *)&x;
+				const unsigned char *yb = (const void *)&y;
+				return (int)xb[k] - (int)yb[k];
+			}
+		}
+		l = (const void *)wl;
+	}
+#endif
 	for (; n && *l == *r; n--, l++, r++);
-	return n ? *l-*r : 0;
+	return n ? (int)*l - (int)*r : 0;
 }
-- 
