From 08396835a0f95e85abf3fb52bacd79fb7917170f Mon Sep 17 00:00:00 2001
From: HiGarfield <HiGarfield@126.com>
Date: Sun, 22 Nov 2026 21:04:13 +0800
Subject: [PATCH] refactor(malloc): add allocator lifecycle hooks to base libc

Add weak no-op malloc hooks at process, thread and fork lifecycle points
so a separate allocator implementation can take over the malloc API
without modifying core libc call sites:

- __malloc_process_init in static startup and the dynamic linker
- __malloc_thread_init / __malloc_thread_finalize in pthread create and exit
- __malloc_atfork in fork, after signals are restored
- a malloc_heap slot in struct pthread, initialized for new threads

The hooks resolve to no-ops in this commit, so the built-in allocator keeps
exactly the same behavior. This lays down the integration points for the
allocator implementation that follows in the next commit.
---
 ldso/dynlink.c              | 7 +++++++
 src/env/__libc_start_main.c | 4 ++++
 src/internal/pthread_impl.h | 1 +
 src/process/fork.c          | 2 ++
 src/thread/pthread_create.c | 6 ++++++
 5 files changed, 20 insertions(+)

diff --git a/ldso/dynlink.c b/ldso/dynlink.c
index 7ac0bf7..49f8a3d 100644
--- a/ldso/dynlink.c
+++ b/ldso/dynlink.c
@@ -144,6 +144,7 @@ static struct fdpic_dummy_loadmap app_dummy_loadmap;
 struct debug *_dl_debug_addr = &debug;
 
 extern hidden int __malloc_replaced;
+extern hidden int __malloc_process_init(void);
 
 hidden void (*const __init_array_start)(void)=0, (*const __fini_array_start)(void)=0;
 
@@ -1503,6 +1504,7 @@ static void do_init_fini(struct dso **queue)
 
 void __libc_start_init(void)
 {
+	if (__malloc_process_init() < 0) _exit(127);
 	do_init_fini(main_ctor_queue);
 	if (!__malloc_replaced && main_ctor_queue != builtin_ctor_queue)
 		free(main_ctor_queue);
@@ -1839,6 +1841,11 @@ void __dls3(size_t *sp)
 	reclaim_gaps(&app);
 	reclaim_gaps(&ldso);
 
+	if (__malloc_process_init() < 0) {
+		dprintf(2, "%s: failed to initialize malloc\n", argv[0]);
+		_exit(127);
+	}
+
 	/* Load preload/needed libraries, add symbols to global namespace. */
 	ldso.deps = (struct dso **)no_deps;
 	if (env_preload) load_preload(env_preload);
diff --git a/src/env/__libc_start_main.c b/src/env/__libc_start_main.c
index 8fbe526..4ff319d 100644
--- a/src/env/__libc_start_main.c
+++ b/src/env/__libc_start_main.c
@@ -10,6 +10,9 @@
 static void dummy(void) {}
 weak_alias(dummy, _init);
 
+static int dummy_int(void) { return 0; }
+weak_alias(dummy_int, __malloc_process_init);
+
 extern weak hidden void (*const __init_array_start)(void), (*const __init_array_end)(void);
 
 static void dummy1(void *p) {}
@@ -58,6 +61,7 @@ void __init_libc(char **envp, char *pn)
 
 static void libc_start_init(void)
 {
+	if (__malloc_process_init() < 0) a_crash();
 	_init();
 	uintptr_t a = (uintptr_t)&__init_array_start;
 	for (; a<(uintptr_t)&__init_array_end; a+=sizeof(void(*)()))
diff --git a/src/internal/pthread_impl.h b/src/internal/pthread_impl.h
index 5742dfc..46d4831 100644
--- a/src/internal/pthread_impl.h
+++ b/src/internal/pthread_impl.h
@@ -48,6 +48,7 @@ struct pthread {
 	volatile int killlock[1];
 	char *dlerror_buf;
 	void *stdio_locks;
+	void *malloc_heap;
 
 	/* Part 3 -- the positions of these fields relative to
 	 * the end of the structure is external and internal ABI. */
diff --git a/src/process/fork.c b/src/process/fork.c
index fb42478..af86e7a 100644
--- a/src/process/fork.c
+++ b/src/process/fork.c
@@ -10,6 +10,7 @@ static void dummy(int x)
 }
 
 weak_alias(dummy, __fork_handler);
+weak_alias(dummy, __malloc_atfork);
 
 pid_t fork(void)
 {
@@ -32,6 +33,7 @@ pid_t fork(void)
 		libc.threads_minus_1 = 0;
 	}
 	__restore_sigs(&set);
+	__malloc_atfork(!ret);
 	__fork_handler(!ret);
 	return __syscall_ret(ret);
 }
diff --git a/src/thread/pthread_create.c b/src/thread/pthread_create.c
index 6bdfb44..3eef137 100644
--- a/src/thread/pthread_create.c
+++ b/src/thread/pthread_create.c
@@ -16,6 +16,8 @@ weak_alias(dummy_0, __pthread_tsd_run_dtors);
 weak_alias(dummy_0, __do_orphaned_stdio_locks);
 weak_alias(dummy_0, __dl_thread_cleanup);
 weak_alias(dummy_0, __membarrier_init);
+weak_alias(dummy_0, __malloc_thread_init);
+weak_alias(dummy_0, __malloc_thread_finalize);
 
 static int tl_lock_count;
 static int tl_lock_waiters;
@@ -68,6 +70,7 @@ _Noreturn void __pthread_exit(void *result)
 	}
 
 	__pthread_tsd_run_dtors();
+	__malloc_thread_finalize();
 
 	/* Access to target the exiting thread with syscalls that use
 	 * its kernel tid is controlled by killlock. For detached threads,
@@ -192,6 +195,7 @@ static int start(void *p)
 		}
 	}
 	__syscall(SYS_rt_sigprocmask, SIG_SETMASK, &args->sig_mask, 0, _NSIG/8);
+	__malloc_thread_init();
 	__pthread_exit(args->start_func(args->start_arg));
 	return 0;
 }
@@ -200,6 +204,7 @@ static int start_c11(void *p)
 {
 	struct start_args *args = p;
 	int (*start)(void*) = (int(*)(void*)) args->start_func;
+	__malloc_thread_init();
 	__pthread_exit((void *)(uintptr_t)start(args->start_arg));
 	return 0;
 }
@@ -299,6 +304,7 @@ int __pthread_create(pthread_t *restrict res, const pthread_attr_t *restrict att
 	}
 
 	new = __copy_tls(tsd - libc.tls_size);
+	new->malloc_heap = 0;
 	new->map_base = map;
 	new->map_size = size;
 	new->stack = stack;
-- 
2.43.0

